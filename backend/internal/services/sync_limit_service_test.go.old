// TestSyncLimitService_GetHistoricalDepthLimit_Success tests getting historical depth limit for a tier
func TestSyncLimitService_GetHistoricalDepthLimit_Success(t *testing.T) {
	ctx := context.Background()
	userID := "user-123"

	mockSyncAuditRepo := new(MockSyncAuditRepository)
	mockSubscriptionService := new(MockSubscriptionService)

	// User is on free tier with 30 days historical limit
	mockSubscriptionService.On("GetEffectiveSubscription", ctx, userID).Return(
		&domain.EffectiveSubscription{
			UserID: userID,
			Tier:   domain.TierFree,
			Limits: domain.SubscriptionLimits{
				TransactionHistoryDays: 30,
			},
		}, nil,
	)

	service := NewSyncLimitService(mockSyncAuditRepo, mockSubscriptionService)

	daysHistorical, err := service.GetHistoricalDepthLimit(ctx, userID)

	assert.NoError(t, err)
	assert.Equal(t, 30, daysHistorical)
	mockSubscriptionService.AssertExpectations(t)
}

