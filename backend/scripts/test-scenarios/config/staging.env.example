# BoostedBudget Test Scenarios - Staging Environment Configuration
# Copy this file to staging.env and fill in your actual values

# API Configuration
API_BASE_URL="https://staging.boostedbudget.com"
AUTH_TOKEN="your-auth0-jwt-token-here"

# Database Configuration
DATABASE_URL="postgresql://user:password@staging-db-host:5432/boostedbudget"

# Test Configuration
CLEANUP_AFTER_TEST=true
TEST_USER_PREFIX="test-user-"
TEST_TIMEOUT_SECONDS=30

# Plaid Configuration (for reference, not used directly by scripts)
PLAID_ENV="sandbox"
PLAID_CLIENT_ID="your-plaid-client-id"
PLAID_SECRET="your-plaid-secret"

# Reporting
REPORT_OUTPUT_DIR="./reports"
REPORT_FORMAT="html,json"

# Logging
DEBUG=false
VERBOSE=true
