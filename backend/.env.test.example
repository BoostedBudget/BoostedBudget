# E2E Test Environment Configuration
# Copy this file to .env.test and fill in the values
# Issue #331: E2E Test Scenarios Framework

# Server Configuration
PORT=8080
ENVIRONMENT=test
VERSION=0.1.0-test
PRIMARY_REGION=iad
TEST_MODE=true

# Database (Test database on different port to avoid conflicts)
DATABASE_URL=postgres://testuser:testpass@localhost:5433/boostedbudget_test?sslmode=disable

# Redis (Test Redis on different port)
REDIS_URL=redis://localhost:6380

# Auth0 Test Tenant (Use dedicated test tenant)
# Create a separate Auth0 tenant for testing to isolate test users
TEST_AUTH0_DOMAIN=test-boostedbudget.us.auth0.com
TEST_AUTH0_AUDIENCE=https://api.test.boostedbudget.com
TEST_AUTH0_CLIENT_ID=your_test_auth0_client_id
TEST_AUTH0_CLIENT_SECRET=your_test_auth0_client_secret

# Plaid Sandbox (Use sandbox environment for tests)
TEST_PLAID_CLIENT_ID=your_test_plaid_client_id
TEST_PLAID_SECRET=your_test_plaid_secret
PLAID_ENV=sandbox
PLAID_REDIRECT_URI=http://localhost:3000/oauth/callback
PLAID_WEBHOOK_URL=http://localhost:8081/api/v1/webhooks/plaid

# Test User Credentials (for Playwright E2E tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPass123!

# Feature Flags (Disable unnecessary services for tests)
RABBITMQ_ENABLED=false
STRIPE_ENABLED=false
ADSENSE_ENABLED=false

# Logging
LOG_LEVEL=debug

# Admin Endpoints (Enable for test scenarios)
ENABLE_ADMIN_ENDPOINTS=true

# Performance Settings
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000

# Test-Specific Settings
SKIP_EMAIL_VERIFICATION=true
FAST_PASSWORD_HASHING=true  # Use bcrypt with lower rounds for faster tests
