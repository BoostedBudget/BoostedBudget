# Development Dockerfile for Backend
FROM golang:1.25-bookworm

# Install dependencies for hot reload, health checks, and migrations
RUN echo "📦 Installing build dependencies..." && \
    for i in 1 2 3; do \
      echo "Attempt $i/3..." && \
      apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates tzdata && \
      rm -rf /var/lib/apt/lists/* && \
      echo "✓ Dependencies installed" && break || \
      { echo "⚠ apt-get attempt $i/3 failed"; \
        [ $i -lt 3 ] && sleep 5; }; \
    done && \
    echo "📦 Installing air for hot reload..." && \
    for i in 1 2 3; do \
      go install github.com/air-verse/air@latest && break || \
      { echo "⚠ go install attempt $i/3 failed"; [ $i -lt 3 ] && sleep 10; }; \
    done && \
    echo "📦 Installing Atlas CLI for database migrations..." && \
    for i in 1 2 3; do \
      curl -sSfL --retry 3 --retry-delay 5 --connect-timeout 10 \
        "https://release.ariga.io/atlas/atlas-linux-amd64-latest" \
        -o /usr/local/bin/atlas && \
      chmod +x /usr/local/bin/atlas && \
      echo "✓ Atlas installed successfully" && break || \
      { echo "⚠ Atlas download attempt $i/3 failed"; [ $i -lt 3 ] && sleep 5; }; \
    done

WORKDIR /app

# Copy go mod files from backend directory
COPY backend/go.mod backend/go.sum ./
RUN echo "📦 Downloading Go modules..." && \
    for i in 1 2 3; do \
      go mod download && break || \
      { echo "⚠ Download attempt $i/3 failed"; [ $i -lt 3 ] && sleep 10; }; \
    done

# Copy config from project root (CRITICAL: Required for subscription tiers)
COPY config ./config

# Copy backend source
COPY backend .


# Build server binary (required by docker-entrypoint.sh)
RUN echo "🔨 Building server binary..." && \
    go build -o /app/server ./cmd/server && \
    echo "✓ Server binary built successfully"

# Make entrypoint script executable (already copied with backend source)
# Verify file exists and show first 5 lines for debugging
RUN chmod +x /app/scripts/docker-entrypoint.sh && \
    echo "✓ Entrypoint script verification:" && \
    ls -la /app/scripts/docker-entrypoint.sh && \
    echo "✓ First 5 lines:" && \
    head -5 /app/scripts/docker-entrypoint.sh

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Use entrypoint for E2E tests (runs migrations then starts server)
# For local dev with hot-reload, override with: docker-compose run --entrypoint air backend
# Force unbuffered output and redirect stderr to stdout for debugging
CMD ["/bin/bash", "-c", "/app/scripts/docker-entrypoint.sh 2>&1"]
