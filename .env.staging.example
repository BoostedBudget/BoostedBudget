# BoostedBudget Staging Environment Configuration
# Copy this file to .env.staging and fill in your actual values
# NEVER commit .env.staging to version control!

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Environment
NODE_ENV=staging
GO_ENV=staging
ENVIRONMENT=staging

# API Base URLs
# NOTE: Update these with your actual Tailscale hostname after installing Tailscale
# Example: http://mac-mini.tailnet-name.ts.net:8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Primary Region (GDPR data residency)
PRIMARY_REGION=iad

# Server Configuration
BACKEND_PORT=8080
FRONTEND_PORT=3000
VERSION=staging-dev

# CORS Configuration
# Comma-separated list of allowed origins for CORS requests
# For staging: Include Tailscale URL and localhost
# For production: Set to your actual domain(s)
# Default: * (allows all origins - dev/test only)
CORS_ALLOWED_ORIGINS=https://yingyues-mac-mini.tailce219d.ts.net:3443,https://localhost:3443

#==============================================================================
# DATABASE CONFIGURATION (Staging)
#==============================================================================

# PostgreSQL Database
POSTGRES_USER=staginguser
POSTGRES_PASSWORD=changeme_staging_db_password
DATABASE_URL=postgresql://staginguser:changeme_staging_db_password@localhost:5433/boostedbudget_staging?sslmode=disable

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

#==============================================================================
# REDIS CONFIGURATION (Staging)
#==============================================================================

# Redis Cache
REDIS_URL=redis://localhost:6380/0

# Redis TTL (cache time-to-live)
REDIS_TTL=300

#==============================================================================
# RABBITMQ CONFIGURATION (Staging)
#==============================================================================

# RabbitMQ Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

#==============================================================================
# AUTH0 CONFIGURATION (DEV TENANT - STAGING)
#==============================================================================
# IMPORTANT: Use a separate Auth0 dev tenant for staging, NOT production tenant
# Create at: https://manage.auth0.com/
# See docs/AUTH0_SETUP.md for complete setup guide

# Auth0 Domain (e.g., dev-yourtenant.us.auth0.com)
AUTH0_DOMAIN=dev-yourtenant.us.auth0.com

# Auth0 Backend API (M2M Application)
AUTH0_AUDIENCE=https://api-staging.boostedbudget.com
AUTH0_CLIENT_ID=your_staging_backend_client_id_here
AUTH0_CLIENT_SECRET=your_staging_backend_client_secret_here

# Auth0 Frontend SPA Application
VITE_AUTH0_DOMAIN=${AUTH0_DOMAIN}
VITE_AUTH0_CLIENT_ID=your_staging_frontend_client_id_here
VITE_AUTH0_AUDIENCE=${AUTH0_AUDIENCE}
VITE_AUTH0_REDIRECT_URI=${FRONTEND_URL}/callback

# Auth0 Management API (for user metadata updates)
AUTH0_MANAGEMENT_CLIENT_ID=your_staging_management_client_id_here
AUTH0_MANAGEMENT_CLIENT_SECRET=your_staging_management_client_secret_here

#==============================================================================
# PLAID CONFIGURATION (SANDBOX MODE)
#==============================================================================
# IMPORTANT: Always use sandbox mode for staging
# Get these from Plaid Dashboard: https://dashboard.plaid.com/

# Plaid Environment: MUST be sandbox for staging
PLAID_ENV=sandbox

# Plaid Credentials (Sandbox)
PLAID_CLIENT_ID=your_plaid_sandbox_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here

# Plaid Products (comma-separated)
PLAID_PRODUCTS=auth,transactions,balance

# Plaid Country Codes (comma-separated)
PLAID_COUNTRY_CODES=US,CA,GB

# Plaid Webhook URL
# Update with your Tailscale hostname: http://mac-mini.tailnet-name.ts.net:8080/webhooks/plaid
PLAID_WEBHOOK_URL=http://localhost:8080/webhooks/plaid

# Plaid Redirect URI (for OAuth bank connections)
PLAID_REDIRECT_URI=http://localhost:3000/oauth-callback

#==============================================================================
# STRIPE CONFIGURATION (TEST MODE)
#==============================================================================
# IMPORTANT: Always use test mode keys for staging
# Get these from Stripe Dashboard: https://dashboard.stripe.com/test

# Stripe API Keys (TEST MODE)
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here

# Stripe Webhook Secret (from Stripe Dashboard > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_test_your_test_webhook_secret_here

# Stripe Product/Price IDs (create in test mode)
STRIPE_PREMIUM_PRICE_ID=price_test_premium_monthly_here
STRIPE_PREMIUM_PLUS_PRICE_ID=price_test_premium_plus_monthly_here

# Stripe Customer Portal URL (test mode)
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/test_xxx

# Trial Period (days)
STRIPE_TRIAL_PERIOD_DAYS=14

#==============================================================================
# GOOGLE ADSENSE CONFIGURATION (Optional - Test Ads)
#==============================================================================
# For staging, you can use test ad slots or leave blank

# AdSense Publisher ID
VITE_ADSENSE_CLIENT_ID=

# AdSense Ad Slot IDs
VITE_ADSENSE_DASHBOARD_SLOT=
VITE_ADSENSE_SIDEBAR_SLOT=

#==============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
#==============================================================================

# SMTP Server (e.g., SendGrid, Mailgun, AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here

# Email Sender
EMAIL_FROM=staging@boostedbudget.com
EMAIL_FROM_NAME=BoostedBudget Staging

#==============================================================================
# LOGGING & MONITORING
#==============================================================================

# Log Level: debug, info, warn, error
LOG_LEVEL=debug

# Log Format: json, text
LOG_FORMAT=json

# Sentry DSN (optional - use separate Sentry project for staging)
SENTRY_DSN=

#==============================================================================
# SECURITY
#==============================================================================

# Encryption Key for sensitive data (32 bytes for AES-256)
# REQUIRED: Used to encrypt Plaid access tokens and other sensitive data
# Generate with: openssl rand -base64 24 | tr -d '=' | head -c 32
# MUST be exactly 32 characters/bytes
# IMPORTANT: Use different key than production!
ENCRYPTION_KEY=your_32_byte_staging_encryption_key

# CORS Allowed Origins (comma-separated)
# Update with your Tailscale hostname
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://mac-mini.tailnet-name.ts.net:3000

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_staging_session_secret_here

# JWT Secret (generate with: openssl rand -base64 32)
# Note: Auth0 handles JWT signing, this is for any additional app tokens
JWT_SECRET=your_staging_jwt_secret_here

#==============================================================================
# FEATURE FLAGS
#==============================================================================

# Enable/Disable Features
FEATURE_RULES_ENGINE=true
FEATURE_AI_INSIGHTS=false
FEATURE_MULTI_REGION=false

#==============================================================================
# DEVELOPMENT TOOLS
#==============================================================================

# Enable development tools
ENABLE_SWAGGER_UI=true
ENABLE_PRISM_MOCK=false

# Hot Reload
VITE_HMR_ENABLED=true

#==============================================================================
# NOTES FOR STAGING
#==============================================================================
# 1. Copy this file: cp .env.staging.example .env.staging
# 2. Fill in all credentials (use test/sandbox/dev credentials ONLY)
# 3. NEVER commit .env.staging to git (it's in .gitignore)
# 4. Use separate Auth0 dev tenant (not production)
# 5. Use Plaid sandbox mode ALWAYS
# 6. Use Stripe test mode keys ONLY
# 7. Generate new encryption key (different from production)
# 8. Update Tailscale hostname after setting up Tailscale
#
# Security Reminders:
# - ALL credentials should be test/sandbox/dev versions
# - NEVER use production credentials in staging
# - Rotate secrets regularly
# - Use different encryption keys for staging vs production
#
# Access via Tailscale VPN:
# - Frontend: http://mac-mini.tailnet-name.ts.net:3000
# - Backend API: http://mac-mini.tailnet-name.ts.net:8080
# - RabbitMQ UI: http://mac-mini.tailnet-name.ts.net:15673
