{
  "name": "@boostedbudget/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "test": "bun test --timeout 30000 src/",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/vitest run --config vitest.config.ts --no-isolate --max-workers=1",
    "test:integration:transport": "node --experimental-vm-modules node_modules/.bin/vitest run --config vitest.transport.config.ts --no-isolate --max-workers=1",
    "test:watch": "bun test --timeout 30000 --watch src/",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --max-warnings 0",
    "build:spec-index": "bun run src/spec/index-builder.ts",
    "build:facade": "bun run scripts/generate-facade.ts",
    "build:artifacts": "bun run build:spec-index && bun run build:facade",
    "check:manifest": "bun run scripts/check-manifest-completeness.ts",
    "check:no-bypass": "bun run scripts/check-no-direct-api-calls.ts",
    "check:artifacts-committed": "git diff --exit-code -- src/spec/generated/ src/client/generated/",
    "check:all": "bun run check:manifest && bun run check:no-bypass && bun run build:artifacts && bun run check:artifacts-committed"
  },
  "dependencies": {
    "@boostedbudget/api-client": "workspace:*",
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.22.0",
    "jose": "^6.2.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^16.0.8",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20260604.1",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.1",
    "globals": "^17.6.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.129.0",
    "yaml": "^2.8.3"
  }
}
