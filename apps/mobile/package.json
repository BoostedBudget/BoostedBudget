{
  "name": "@boostedbudget/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --coverage --runInBand",
    "doctor": "expo-doctor",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:android": "expo export --platform android --output-dir dist/android",
    "gate:nativewind": "bun run scripts/nativewind-gate.ts",
    "serve:web": "bun run scripts/serve-web.ts",
    "e2e:visual": "playwright test --config playwright.config.ts",
    "build": "bun run export:web && bun run export:ios && bun run export:android"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@boostedbudget/api-client": "workspace:*",
    "@boostedbudget/design-tokens": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "^7.28.6",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-preset-expo": "~57.0.11",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.1.0",
    "expo-doctor": "1.20.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3"
  }
}
