# Clerk Configuration
# Get this value from your Clerk dashboard: https://dashboard.clerk.com/
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Public key for the matching RevenueCat Paddle app. Never use a secret API key.
VITE_REVENUECAT_PUBLIC_API_KEY=

# API Configuration
VITE_API_URL=/api

# PostHog Analytics (optional - leave empty to disable)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
