# E2E Test Environment Configuration
# Copy to .env.test and fill in actual values for running E2E tests

# Clerk Test Credentials
# Create a test user in your Clerk test tenant for E2E testing
TEST_CLERK_EMAIL=test-user@example.com
TEST_CLERK_PASSWORD=TestPassword123!

# Second Clerk test identity (issue #1370: household invite E2E specs need two
# independently-authenticated users — an "owner" and an "invitee"). Use Clerk's test-mode
# email convention (any_email+clerk_test@example.com, verification code 424242) so
# clerk.signIn({page, emailAddress}) can sign in without a real inbox/password check.
# Provisioned on demand (idempotently) by e2e/helpers/clerk-admin.ts's
# ensureTestUserExists() via the Clerk Backend API — no manual Dashboard setup required.
TEST_CLERK_EMAIL_2=e2e-invitee+clerk_test@boostedbudget.com
TEST_CLERK_PASSWORD_2=TestPassword123!

# Clerk Configuration (should match your test tenant)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Test Environment URLs
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:8080

# Optional: Use headless mode
HEADLESS=true
