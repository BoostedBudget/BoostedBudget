{
  "name": "@boostedbudget/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bash scripts/test-regular.sh && bash scripts/test-conflict-files.sh",
    "test:ci": "bash scripts/test-regular.sh --coverage && bash scripts/test-conflict-files.sh --coverage",
    "test:watch": "bun test --timeout 30000 --watch src/",
    "test:integration": "bun test --timeout 30000 scripts/integration/",
    "test:revenuecat-fixture": "bun test --timeout 30000 scripts/integration/revenuecat-fixture.test.ts",
    "test:e2e": "bash scripts/run-e2e-with-ports.sh",
    "test:e2e:ci": "bash scripts/run-e2e-ci.sh",
    "test:e2e:ui": "bash scripts/run-e2e-with-ports.sh --ui",
    "test:e2e:headed": "bash scripts/run-e2e-with-ports.sh --headed",
    "test:e2e:debug": "bash scripts/run-e2e-with-ports.sh --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:rrweb-mask-proof": "playwright test --config=e2e/rrweb-mask-proof/playwright.config.ts",
    "test:all": "tsc --noEmit && bun test --timeout 30000 src/ && bun run test:rrweb-mask-proof && bun run test:e2e",
    "typecheck": "tsc --noEmit && bun run typecheck:tests",
    "typecheck:tests": "bash scripts/typecheck-tests.sh",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lighthouse": "lhci autorun",
    "check-size": "cd ../.. && npx size-limit"
  },
  "dependencies": {
    "@boostedbudget/api-client": "workspace:*",
    "@boostedbudget/design-tokens": "workspace:*",
    "@boostedbudget/shared-types": "workspace:*",
    "@clerk/react-router": "^3.6.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@reduxjs/toolkit": "^2.14.0",
    "@revenuecat/purchases-js": "^1.60.1",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/react-datepicker": "^7.0.0",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.0.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "gridstack": "^13.0.2",
    "js-cookie": "^3.0.7",
    "lucide-react": "^1.17.0",
    "posthog-js": "1.430.2",
    "react": "19.2.3",
    "react-colorful": "^5.6.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.3",
    "react-plaid-link": "^4.1.1",
    "react-redux": "^9.3.0",
    "react-router": "^7.18.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.34",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@happy-dom/global-registrator": "^20.10.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bun": "^1.3.14",
    "@types/js-cookie": "^3.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.161.0"
  }
}
