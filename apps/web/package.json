{
  "name": "@boostedbudget/web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bash scripts/test-regular.sh",
    "test:all-files": "bun test src/",
    "test:real": "bash scripts/test-real-implementations.sh",
    "test:isolated": "bash scripts/test-isolated.sh",
    "test:coverage": "bash scripts/test-regular.sh --coverage",
    "test:real:coverage": "bash scripts/test-real-implementations.sh --coverage",
    "test:isolated:coverage": "bash scripts/test-isolated.sh --coverage",
    "test:coverage:combine": "bash scripts/combine-coverage.sh",
    "test:coverage:combine:check": "bash scripts/combine-coverage.sh --check-threshold",
    "test:watch": "bun test --watch src/",
    "test:ci": "tsc --noEmit && bash scripts/test-regular.sh --coverage && bun run test:real:coverage && bun run test:isolated:coverage && bun run test:coverage:combine",
    "test:integration": "bun test scripts/integration/",
    "test:e2e": "bash scripts/run-e2e-with-ports.sh",
    "test:e2e:ci": "bash scripts/run-e2e-with-ports.sh",
    "test:e2e:ui": "bash scripts/run-e2e-with-ports.sh --ui",
    "test:e2e:headed": "bash scripts/run-e2e-with-ports.sh --headed",
    "test:e2e:debug": "bash scripts/run-e2e-with-ports.sh --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:all": "tsc --noEmit && bun test src/ && bun run test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "lighthouse": "lhci autorun",
    "check-size": "cd ../.. && npx size-limit"
  },
  "dependencies": {
    "@boostedbudget/api-client": "workspace:*",
    "@boostedbudget/shared-types": "workspace:*",
    "@clerk/react-router": "^3.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react": "^10.46.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.96.1",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-window": "^2.0.0",
    "axios": "^1.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gridstack": "^12.6.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.577.0",
    "plotly.js-basic-dist": "^3.4.0",
    "posthog-js": "^1.364.4",
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.4",
    "react-plaid-link": "^4.1.1",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.2",
    "react-router-dom": "^7.13.2",
    "react-window": "^2.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@clerk/testing": "^2.0.2",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.4.0",
    "@happy-dom/global-registrator": "^20.8.3",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "^1.3.11",
    "@types/js-cookie": "^3.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-plotly.js": "^2.6.4",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.1.4",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.0.1",
    "msw": "^2.13.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "wrangler": "^4.79.0"
  }
}
