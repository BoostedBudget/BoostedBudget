{
  "name": "@boostedbudget/design-tokens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/tokens.ts",
    "./web.css": "./generated/web.css",
    "./nativewind.css": "./generated/nativewind.css",
    "./native": "./generated/native.ts",
    "./nativewind-exclude.json": "./generated/nativewind-exclude.json"
  },
  "scripts": {
    "generate": "bun run scripts/generate.ts",
    "check": "bun run scripts/generate.ts --check",
    "build": "bun run check && tsc --noEmit",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "colorjs.io": "0.7.0",
    "typescript": "^5.9.3"
  }
}
