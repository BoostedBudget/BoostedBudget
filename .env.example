# BoostedBudget Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Environment: development, staging, production
NODE_ENV=development
GO_ENV=development

# API Base URLs
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Primary Region (GDPR data residency)
# Options: iad (Virginia), lhr (London), syd (Sydney) - Fly.io IATA codes
# Default: iad (MVP single region - US East Virginia)
PRIMARY_REGION=iad

# Server Configuration
BACKEND_PORT=8080
FRONTEND_PORT=3000

#==============================================================================
# DATABASE CONFIGURATION (Local Development)
#==============================================================================

# PostgreSQL Database (Local Docker)
# Format: postgresql://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/boostedbudget?sslmode=disable

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

#==============================================================================
# NEON DATABASE CONFIGURATION (Staging/Production)
#==============================================================================
# Neon connection strings from: https://console.neon.tech/
# Neon is a serverless PostgreSQL with built-in connection pooling.
#
# Connection String Formats:
# - Pooled (for application): postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# - Direct (for migrations):  postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# The pooled endpoint (-pooler) handles connection limits efficiently.
# The direct endpoint is required for database migrations (pooler blocks session parameters).
#
# For staging/production, set these via Fly.io secrets:
#   fly secrets set DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
#   fly secrets set MIGRATION_DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
#
# MIGRATION_DATABASE_URL is optional - docker-entrypoint.sh auto-transforms pooler URLs if not set.
# MIGRATION_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

#==============================================================================
# REDIS CONFIGURATION
#==============================================================================

# Redis Cache
# Format: redis://username:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# Redis TTL (cache time-to-live)
REDIS_TTL=300

#==============================================================================
# RABBITMQ CONFIGURATION
#==============================================================================

# RabbitMQ Message Queue
# Format: amqp://username:password@host:port/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

#==============================================================================
# CLERK CONFIGURATION
#==============================================================================
# Get these from your Clerk Dashboard: https://dashboard.clerk.com/
# See docs/CLERK_SETUP.md for complete setup guide

# Clerk Backend Secret Key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Frontend Publishable Key (starts with pk_test_ or pk_live_)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Clerk Frontend Publishable Key (exposed to browser via Vite)
VITE_CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}

#==============================================================================
# PLAID CONFIGURATION
#==============================================================================
# Get these from Plaid Dashboard: https://dashboard.plaid.com/
# Documentation: https://plaid.com/docs/

# Plaid Environment: sandbox, development, production
PLAID_ENV=sandbox

# Plaid Credentials
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# Plaid Products (comma-separated)
# Options: auth, transactions, balance, identity, investments
PLAID_PRODUCTS=auth,transactions,balance

# Plaid Country Codes (comma-separated)
PLAID_COUNTRY_CODES=US,CA,GB

# Plaid Webhook URL (must be HTTPS and publicly accessible)
# Production: Your deployed API endpoint
# Local: Use ngrok/localtunnel OR leave as localhost (webhooks will fail locally but won't break app)
PLAID_WEBHOOK_URL=https://api.boostedbudget.com/webhooks/plaid

# Plaid Redirect URI (for OAuth bank connections)
# Production: Your deployed frontend callback endpoint
# Local: Localhost works fine for OAuth redirects (browser-based)
PLAID_REDIRECT_URI=https://boostedbudget.com/oauth-callback

#==============================================================================
# PADDLE CONFIGURATION (Payments)
#==============================================================================
# Get these from Paddle Dashboard: https://vendors.paddle.com/
# Documentation: https://developer.paddle.com/

# Paddle API Key (from Paddle Dashboard > Developer Tools > Authentication)
PADDLE_API_KEY=your_paddle_api_key_here

# Paddle Webhook Secret (from Paddle Dashboard > Developer Tools > Notifications)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret_here

# Paddle Product/Price IDs
# Create these in Paddle Dashboard > Catalog > Products
PADDLE_PREMIUM_PRICE_ID=pri_premium_monthly_here
PADDLE_PREMIUM_PLUS_PRICE_ID=pri_premium_plus_monthly_here

# Paddle Client-Side Token (for frontend checkout)
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_token_here

# Paddle Environment: sandbox or production
PADDLE_ENV=sandbox

# Trial Period (days)
PADDLE_TRIAL_PERIOD_DAYS=14

#==============================================================================
# GOOGLE ADSENSE CONFIGURATION
#==============================================================================
# Get these from Google AdSense: https://www.google.com/adsense/
# Documentation: https://support.google.com/adsense/

# AdSense Publisher ID (e.g., ca-pub-1234567890123456)
VITE_ADSENSE_CLIENT_ID=ca-pub-your_publisher_id_here

# AdSense Ad Slot IDs (create these in AdSense Dashboard)
VITE_ADSENSE_DASHBOARD_SLOT=your_dashboard_ad_slot_id
VITE_ADSENSE_SIDEBAR_SLOT=your_sidebar_ad_slot_id

#==============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
#==============================================================================

# SMTP Server (e.g., SendGrid, Mailgun, AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here

# Email Sender
EMAIL_FROM=noreply@boostedbudget.com
EMAIL_FROM_NAME=BoostedBudget

#==============================================================================
# LOGGING & MONITORING
#==============================================================================

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Log Format: json, text
LOG_FORMAT=json

# Sentry DSN (optional - for error tracking)
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

#==============================================================================
# SECURITY
#==============================================================================

# JWT Secret (generate with: openssl rand -base64 32)
# Note: Clerk handles JWT signing, this is for any additional app tokens (e.g., deletion cancellation)
JWT_SECRET=your_random_32_byte_secret_here

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here

# Encryption Key for sensitive data (32 bytes for AES-256)
# REQUIRED: Used to encrypt Plaid access tokens and other sensitive data
# Generate with: openssl rand -base64 24 | tr -d '=' | head -c 32
# MUST be exactly 32 characters/bytes
ENCRYPTION_KEY=your_32_byte_encryption_key_here

#==============================================================================
# FEATURE FLAGS (Optional)
#==============================================================================

# Enable/Disable Features
FEATURE_RULES_ENGINE=true
FEATURE_AI_INSIGHTS=false
FEATURE_MULTI_REGION=false

#==============================================================================
# FLY.IO DEPLOYMENT (Staging/Production)
#==============================================================================
# These are set automatically by Fly.io - don't set locally

# FLY_APP_NAME=boostedbudget-api (or boostedbudget-staging-api)
# FLY_REGION=iad
# FLY_ALLOC_ID=allocated_by_fly

# Database URLs are set via Fly.io secrets (using Neon):
#   fly secrets set DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
#   fly secrets set MIGRATION_DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
# See NEON DATABASE CONFIGURATION section above for connection string formats.

#==============================================================================
# DEVELOPMENT TOOLS
#==============================================================================

# Enable development tools
ENABLE_SWAGGER_UI=true
ENABLE_PRISM_MOCK=false

# Hot Reload
VITE_HMR_ENABLED=true

#==============================================================================
# NOTES
#==============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual credentials (NEVER commit .env!)
# 3. See README.md for detailed setup instructions
# 4. See docs/CLERK_SETUP.md for Clerk authentication configuration
# 5. See docs/GITHUB_SECRETS_SETUP.md for CI/CD secrets
#
# Security Best Practices:
# - Never commit .env files to version control
# - Use different credentials for dev/staging/prod
# - Rotate secrets regularly
# - Use environment-specific .env files (.env.development, .env.production)
# - Store production secrets in Fly.io secrets or GitHub Secrets
