# BoostedBudget Environment Configuration
# Copy this file to .env and fill in your values

# ==========================================
# Server Configuration
# ==========================================
PORT=8080
ENVIRONMENT=development
VERSION=0.1.0
PRIMARY_REGION=us-east-1

# ==========================================
# Database (PostgreSQL)
# ==========================================
# Local development (docker-compose):
DATABASE_URL=postgres://devuser:devpass@localhost:5432/boostedbudget?sslmode=disable

# Production example:
# DATABASE_URL=postgres://user:password@host:5432/boostedbudget?sslmode=require

# ==========================================
# Redis Cache
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# RabbitMQ Message Queue
# ==========================================
RABBITMQ_URL=amqp://localhost:5672/

# ==========================================
# Auth0 Configuration
# ==========================================
# Get these from your Auth0 dashboard:
# https://manage.auth0.com/dashboard
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.boostedbudget.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_CLIENT_SECRET=your_auth0_client_secret

# ==========================================
# Plaid Configuration
# ==========================================
# Get these from: https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_ENV=sandbox  # sandbox | development | production

# ==========================================
# Stripe Configuration
# ==========================================
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==========================================
# Google AdSense (for Free Tier)
# ==========================================
GOOGLE_ADSENSE_CLIENT=ca-pub-your_adsense_client_id

# ==========================================
# Development Settings
# ==========================================
# Enable debug logging
DEBUG=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
