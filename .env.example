# BoostedBudget Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Environment: development, staging, production
NODE_ENV=development
GO_ENV=development

# API Base URLs
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Primary Region (GDPR data residency)
# See config/regions.yaml for available regions. Default: iad (US East Virginia)
PRIMARY_REGION=iad

# Server Configuration
BACKEND_PORT=8080
FRONTEND_PORT=3000

#==============================================================================
# DATABASE CONFIGURATION (Local Development)
#==============================================================================

# PostgreSQL Database (Local Docker)
# Format: postgresql://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://devuser:devpass@localhost:5432/boostedbudget?sslmode=disable

# Database Connection Pool
DATABASE_MAX_CONNS=25

#==============================================================================
# NEON DATABASE CONFIGURATION (Staging/Production)
#==============================================================================
# Neon connection strings from: https://console.neon.tech/
# Neon is a serverless PostgreSQL with built-in connection pooling.
#
# Connection String Formats:
# - Pooled (for application): postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# - Direct (for migrations):  postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# The pooled endpoint (-pooler) handles connection limits efficiently.
# The direct endpoint is required for database migrations (pooler blocks session parameters).
#
# For staging/production, set these via Fly.io secrets:
#   fly secrets set DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
#   fly secrets set MIGRATION_DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
#
# MIGRATION_DATABASE_URL is optional - docker-entrypoint.sh auto-transforms pooler URLs if not set.
# MIGRATION_DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

#==============================================================================
# REDIS CONFIGURATION (Issue #1531)
#==============================================================================
# TWO SEPARATE Redis instances/URLs are required — never point both of these at the
# same instance. The rate limiter is provisioned --maxmemory-policy noeviction because
# its correctness depends on every SET it issues succeeding; a cache sharing that
# instance will eventually fill it and start getting "OOM command not allowed when used
# memory > 'maxmemory'" on the limiter's own SETs — a permanent limiter fallback to
# in-memory, per-machine limiting, with a cause that looks nothing like its symptom.
# See backend/internal/redisclient/client.go's package doc for the full rationale.

# Rate Limiter Redis (Task 8 rename: was REDIS_URL). MUST be a NO-EVICTION instance
# (local: redis-server --maxmemory-policy noeviction; see docker-compose.yml's
# redis-ratelimit service; sharing this with the cache will OOM the limiter).
# Format: redis://[:password@]host:port/db
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0

# Cache Redis — a DIFFERENT instance from RATE_LIMIT_REDIS_URL above (local:
# docker-compose.yml's redis-cache service, port 6380). Optional: empty means "no
# cache" (Task 9 treats cache-client construction failure as non-fatal).
CACHE_REDIS_URL=redis://localhost:6380/0

# PostHog Support identity verification. POSTHOG_SECRET_API_TOKEN is backend-only;
# never expose it through Vite/window.ENV or commit its real value.
POSTHOG_API_KEY=
POSTHOG_SECRET_API_TOKEN=
# Server-only personal API key and private API target used solely by the durable GDPR-erasure
# worker. Keep staging and production project IDs separate. Host must be exactly one of the two
# allowlisted regional private API origins.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_PRIVATE_HOST=https://us.posthog.com
# Set to one shared RFC3339 instant only after all pre-cutover backend pods are drained.
# Unset fails closed by suppressing first-sync completion events while still latching completion.
POSTHOG_SYNC_COMPLETION_CUTOVER_AT=

# Shared Redis client tuning (used by both RATE_LIMIT_REDIS_URL and CACHE_REDIS_URL clients)
REDIS_TIMEOUT_MS=200
REDIS_POOL_SIZE=10

# Rate limit backend selection: auto (Redis when RATE_LIMIT_REDIS_URL is configured,
# memory otherwise), memory (force in-memory, per-machine), or redis (force Redis-backed).
# Rejected at startup if it is anything else.
RATE_LIMIT_BACKEND=auto

# RATE_LIMIT_SENTINEL_LIMIT — escape hatch. Overrides the fleet-wide sentinel bucket's
# limit at runtime (0 = use RATE_LIMIT_IP). Lets an operator raise the sentinel limit
# during a live incident without a deploy.
RATE_LIMIT_SENTINEL_LIMIT=0

# RATE_LIMIT_FALLBACK_DIVISOR — divides the per-machine in-memory fallback limiter's
# limits so N machines independently falling back to memory-only limiting do not
# multiply the intended fleet-wide budget by N. 1 = no division (today's behavior).
RATE_LIMIT_FALLBACK_DIVISOR=1

# CACHE_ENABLED — top-level cache kill switch.
CACHE_ENABLED=true

# RULE_QUARANTINE_ENFORCE — categorization-rule quarantine kill switch (#1625).
#
# Default ON. A rule whose quarantine reason "stops matching" (no conditions at all, an
# unrecognised condition_logic, an unnormalizable condition, or a condition value that cannot be
# repaired) is refused by the engine before any condition is evaluated, and the rule card tells the
# user it is not running. Set this false to restore the pre-#1625 behaviour of running every rule
# no matter how broken it is.
#
# Parsed with strconv.ParseBool, so false/0/f/F/FALSE/False all disable it and an UNPARSEABLE value
# fails safe (enforcement stays on). It gates enforcement only, never the read-time value coercion
# that keeps legacy rules working.
RULE_QUARANTINE_ENFORCE=true

# CACHE_NAMESPACES_DISABLED — comma-separated list of cache namespaces to bypass
# individually while leaving the rest of the cache enabled. Empty = none disabled.
CACHE_NAMESPACES_DISABLED=

#==============================================================================
# CLERK CONFIGURATION
#==============================================================================
# Get these from your Clerk Dashboard: https://dashboard.clerk.com/
# See docs/CLERK_SETUP.md for complete setup guide

# Clerk Backend Secret Key (starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk Frontend Publishable Key (starts with pk_test_ or pk_live_)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Clerk Frontend Publishable Key (exposed to browser via Vite)
VITE_CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}

#==============================================================================
# PLAID CONFIGURATION
#==============================================================================
# Get these from Plaid Dashboard: https://dashboard.plaid.com/
# Documentation: https://plaid.com/docs/

# Plaid Environment: sandbox, development, production
PLAID_ENV=sandbox

# Plaid Credentials
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# Plaid Products (comma-separated)
# Options: auth, transactions, balance, identity, investments
PLAID_PRODUCTS=auth,transactions,balance

# Plaid Country Codes (comma-separated)
PLAID_COUNTRY_CODES=US,CA,GB

# Plaid Webhook URL (must be HTTPS and publicly accessible)
# Production: Your deployed API endpoint
# Local: Use ngrok/localtunnel OR leave as localhost (webhooks will fail locally but won't break app)
PLAID_WEBHOOK_URL=https://api.boostedbudget.com/webhooks/plaid

# Plaid Redirect URI (for OAuth bank connections)
# Production: Your deployed frontend callback endpoint
# Local: Localhost works fine for OAuth redirects (browser-based)
PLAID_REDIRECT_URI=https://boostedbudget.com/oauth-callback

#==============================================================================
# REVENUECAT CONFIGURATION (Subscription access)
# Required together in staging/production. Locally leave ALL empty if unavailable.
# See docs/runbooks/revenuecat-setup.md. Use separate production/nonproduction projects.
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_GRANT_API_KEY=
# Set sandbox outside production; set production only for the production deployment.
REVENUECAT_ENVIRONMENT=
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# Public web/Paddle SDK key ONLY. Never place a server key in VITE_*.
VITE_REVENUECAT_PUBLIC_API_KEY=

# PADDLE CONFIGURATION (Payments)
#==============================================================================
# Get these from Paddle Dashboard: https://vendors.paddle.com/
# Documentation: https://developer.paddle.com/

# Paddle API Key (from Paddle Dashboard > Developer Tools > Authentication)
PADDLE_API_KEY=your_paddle_api_key_here

# Paddle Webhook Secret (from Paddle Dashboard > Developer Tools > Notifications)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret_here

# Paddle Product/Price IDs
# Create these in Paddle Dashboard > Catalog > Products
PADDLE_PREMIUM_PRICE_ID=pri_premium_monthly_here
PADDLE_PREMIUM_PLUS_PRICE_ID=pri_premium_plus_monthly_here

# Paddle Client-Side Token (for frontend checkout)
VITE_PADDLE_CLIENT_TOKEN=your_paddle_client_token_here

# Paddle Environment: sandbox or production
PADDLE_ENV=sandbox

# Trial Period (days)
PADDLE_TRIAL_PERIOD_DAYS=14


#==============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
#==============================================================================

# SMTP Server (e.g., SendGrid, Mailgun, AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here

# Email Sender
EMAIL_FROM=noreply@boostedbudget.com
EMAIL_FROM_NAME=BoostedBudget

#==============================================================================
# LOGGING & MONITORING
#==============================================================================

# Log Level: debug, info, warn, error
LOG_LEVEL=info

# Log Format: json, text
LOG_FORMAT=json

# Sentry DSN (optional - for error tracking)
SENTRY_DSN=https://your_sentry_dsn_here@sentry.io/project_id

#==============================================================================
# SECURITY
#==============================================================================

# JWT Secret (generate with: openssl rand -base64 32)
# Note: Clerk handles JWT signing, this is for any additional app tokens (e.g., deletion cancellation)
JWT_SECRET=your_random_32_byte_secret_here

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here

# Encryption Key for sensitive data (32 bytes for AES-256)
# REQUIRED: Used to encrypt Plaid access tokens and other sensitive data
# Generate with: openssl rand -base64 24 | tr -d '=' | head -c 32
# MUST be exactly 32 characters/bytes
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# Cloudflare Origin Secret — enforces that all API traffic flows through Cloudflare (#657)
# REQUIRED in production and staging (server refuses to start without it)
# Must match the X-CF-Secret header injected by the Cloudflare Transform Rule
# Generate with: openssl rand -hex 32  (produces 64 hex chars = 256-bit entropy)
# Set via Fly.io secrets: fly secrets set CF_ORIGIN_SECRET=<value> --app <app-name>
# See infrastructure docs for Cloudflare Transform Rule setup
CF_ORIGIN_SECRET=

# Rate Limiter Max Tracked Identities
# Caps how many distinct rate-limited identities (e.g. IPs) the in-memory rate
# limiter store tracks at once, bounding memory use on this app's 512MB VM.
# NOTE: unlike the two webhook settings above, this has no upper bound enforced
# at load time (only <=0 is rejected) — an excessively large value here will
# silently defeat the memory cap instead of being rejected. See issue #1518,
# which tracks this fail-open pattern across config helpers.
RATE_LIMIT_MAX_ENTRIES=20000

# Paddle Webhook Replay Window (seconds)
# How far a Paddle webhook's ts= signature timestamp may drift from this
# server's clock, in either direction, before PaddleWebhookService rejects it
# as a replay/clock-skew risk. Must be in (0, 300]; an out-of-range value
# (e.g. 0 or an operator typo) falls back to the default below and logs a
# warning rather than failing startup.
PADDLE_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=5

# Invalid Webhook Attempt Retention (days)
# How long a rejected (unsigned/invalid-signature) webhook audit row is
# eligible for age-based cleanup. Cleanup is traffic-triggered (runs as a
# side effect of that provider's next rejected webhook), not on a fixed
# schedule — see config.go for the mechanism. Must be in (0, 365]; an
# out-of-range value falls back to the default below and logs a warning
# rather than failing startup.
INVALID_WEBHOOK_ATTEMPT_RETENTION_DAYS=30

# Enable Internal Metrics Listener
# Default true. Gates the internal-only Prometheus metrics listener (resolve,
# bind, register, start) that serves /metrics off the public listener — see
# backend/cmd/server/internal_metrics.go. Setting this false in a Fly
# environment disables that listener entirely; backend/fly.toml and
# fly.staging.toml both point their [metrics] scraper at that same port
# (9091), so disabling it will produce failing scrapes and no monitoring
# data — the intended effect, not a bug, but worth knowing before flipping
# it. It does NOT affect Fly health checks, which hit /health on the public
# listener (internal_port 8080), so app availability is unaffected.
ENABLE_METRICS=true

#==============================================================================
# FEATURE FLAGS (Optional)
#==============================================================================

# Enable/Disable Features
FEATURE_RULES_ENGINE=true
FEATURE_AI_INSIGHTS=false
FEATURE_MULTI_REGION=false

#==============================================================================
# FLY.IO DEPLOYMENT (Staging/Production)
#==============================================================================
# These are set automatically by Fly.io - don't set locally

# FLY_APP_NAME=boostedbudget-api (or boostedbudget-staging-api)
# FLY_REGION=iad
# FLY_ALLOC_ID=allocated_by_fly

# Database URLs are set via Fly.io secrets (using Neon):
#   fly secrets set DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
#   fly secrets set MIGRATION_DATABASE_URL="postgresql://..." -a boostedbudget-staging-api
# See NEON DATABASE CONFIGURATION section above for connection string formats.

#==============================================================================
# DEVELOPMENT TOOLS
#==============================================================================

# Enable development tools
ENABLE_SWAGGER_UI=true
ENABLE_PRISM_MOCK=false

# Hot Reload
VITE_HMR_ENABLED=true

#==============================================================================
# NOTES
#==============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual credentials (NEVER commit .env!)
# 3. See README.md for detailed setup instructions
# 4. See docs/CLERK_SETUP.md for Clerk authentication configuration
# 5. See docs/GITHUB_SECRETS_SETUP.md for CI/CD secrets
#
# Security Best Practices:
# - Never commit .env files to version control
# - Use different credentials for dev/staging/prod
# - Rotate secrets regularly
# - Use environment-specific .env files (.env.development, .env.production)
# - Store production secrets in Fly.io secrets or GitHub Secrets
