# BoostedBudget QA Environment Configuration
# Copy this file to .env.qa and fill in your actual values
# NEVER commit .env.qa to version control!

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Environment
NODE_ENV=qa
GO_ENV=qa
ENVIRONMENT=qa

# API Base URLs
# NOTE: Update these with your actual Tailscale hostname after installing Tailscale
# Example: http://mac-mini.tailnet-name.ts.net:8080
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Primary Region (GDPR data residency)
PRIMARY_REGION=iad

# Server Configuration
BACKEND_PORT=8080
FRONTEND_PORT=3000
VERSION=qa-dev

# CORS Configuration
# Comma-separated list of allowed origins for CORS requests
# For QA: Include Tailscale URL and localhost
# For production: Set to your actual domain(s)
# Default: * (allows all origins - dev/test only)
CORS_ALLOWED_ORIGINS=https://yingyues-mac-mini.tailce219d.ts.net:3443,https://localhost:3443

#==============================================================================
# DATABASE CONFIGURATION (QA)
#==============================================================================

# PostgreSQL Database
POSTGRES_USER=qauser
POSTGRES_PASSWORD=changeme_qa_db_password
DATABASE_URL=postgresql://qauser:changeme_qa_db_password@localhost:5433/boostedbudget_qa?sslmode=disable

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

#==============================================================================
# REDIS CONFIGURATION (QA)
#==============================================================================

# Redis Cache
REDIS_URL=redis://localhost:6380/0

# Redis TTL (cache time-to-live)
REDIS_TTL=300

#==============================================================================
# RABBITMQ CONFIGURATION (QA)
#==============================================================================

# RabbitMQ Message Queue
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

#==============================================================================
# CLERK CONFIGURATION (QA)
#==============================================================================
# IMPORTANT: Use a separate Clerk application for QA, NOT production
# Create at: https://dashboard.clerk.com/
# See docs/CLERK_SETUP.md for complete setup guide

# Clerk Backend Secret Key (starts with sk_test_)
CLERK_SECRET_KEY=sk_test_your_qa_clerk_secret_key_here

# Clerk Frontend Publishable Key (starts with pk_test_)
CLERK_PUBLISHABLE_KEY=pk_test_your_qa_clerk_publishable_key_here

# Clerk Frontend Publishable Key (exposed to browser via Vite)
VITE_CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}

#==============================================================================
# QA AUTH BYPASS (Issue #821)
#==============================================================================
# Used by Claude Code agents for automated auth in QA/Staging environments.
# NEVER set these in production — the route is not registered outside QA/Staging.
# Pre-create test users in Clerk and copy their user IDs here.

# A strong random secret shared between the agent and the backend.
# Generate with: openssl rand -hex 32
QA_BYPASS_SECRET=change-me-to-a-strong-random-secret

# Clerk user ID for qa-admin@boostedbudget.test (must be pre-created in Clerk)
QA_ADMIN_CLERK_USER_ID=user_xxx

# Clerk user ID for qa-premium@boostedbudget.test (must be pre-created in Clerk)
QA_PREMIUM_CLERK_USER_ID=user_xxx

#==============================================================================
# PLAID CONFIGURATION (SANDBOX MODE)
#==============================================================================
# IMPORTANT: Always use sandbox mode for QA
# Get these from Plaid Dashboard: https://dashboard.plaid.com/

# Plaid Environment: MUST be sandbox for QA
PLAID_ENV=sandbox

# Plaid Credentials (Sandbox)
PLAID_CLIENT_ID=your_plaid_sandbox_client_id_here
PLAID_SECRET=your_plaid_sandbox_secret_here

# Plaid Products (comma-separated)
PLAID_PRODUCTS=auth,transactions,balance

# Plaid Country Codes (comma-separated)
PLAID_COUNTRY_CODES=US,CA,GB

# Plaid Webhook URL
# Update with your Tailscale hostname: http://mac-mini.tailnet-name.ts.net:8080/webhooks/plaid
PLAID_WEBHOOK_URL=http://localhost:8080/webhooks/plaid

# Plaid Redirect URI (for OAuth bank connections)
PLAID_REDIRECT_URI=http://localhost:3000/oauth-callback

#==============================================================================
# PADDLE CONFIGURATION (SANDBOX MODE)
#==============================================================================
# IMPORTANT: Always use sandbox mode for QA
# Get these from Paddle Dashboard: https://sandbox-vendors.paddle.com/

# Paddle API Key (from Paddle Dashboard > Developer Tools > Authentication)
PADDLE_API_KEY=your_paddle_sandbox_api_key_here

# Paddle Webhook Secret (from Paddle Dashboard > Developer Tools > Notifications)
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_sandbox_webhook_secret_here

# Paddle Product/Price IDs (create in sandbox mode)
PADDLE_PREMIUM_PRICE_ID=pri_test_premium_monthly_here
PADDLE_PREMIUM_PLUS_PRICE_ID=pri_test_premium_plus_monthly_here

# Paddle Client-Side Token (for frontend checkout)
VITE_PADDLE_CLIENT_TOKEN=your_paddle_sandbox_client_token_here

# Paddle Environment
PADDLE_ENVIRONMENT=sandbox

# Trial Period (days) - 60 days premium trial with ads
PADDLE_TRIAL_PERIOD_DAYS=60

#==============================================================================
# GOOGLE ADSENSE CONFIGURATION (Optional - Test Ads)
#==============================================================================
# For QA, you can use test ad slots or leave blank

# AdSense Publisher ID
VITE_ADSENSE_CLIENT_ID=

# AdSense Ad Slot IDs
VITE_ADSENSE_DASHBOARD_SLOT=
VITE_ADSENSE_SIDEBAR_SLOT=

#==============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
#==============================================================================

# SMTP Server (e.g., SendGrid, Mailgun, AWS SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key_here

# Email Sender
EMAIL_FROM=qa@boostedbudget.com
EMAIL_FROM_NAME=BoostedBudget QA

#==============================================================================
# LOGGING & MONITORING
#==============================================================================

# Log Level: debug, info, warn, error
LOG_LEVEL=debug

# Log Format: json, text
LOG_FORMAT=json

# Sentry DSN (optional - use separate Sentry project for QA)
SENTRY_DSN=

#==============================================================================
# SECURITY
#==============================================================================

# Encryption Key for sensitive data (32 bytes for AES-256)
# REQUIRED: Used to encrypt Plaid access tokens and other sensitive data
# Generate with: openssl rand -base64 24 | tr -d '=' | head -c 32
# MUST be exactly 32 characters/bytes
# IMPORTANT: Use different key than production!
ENCRYPTION_KEY=your_32_byte_qa_encryption_key

# CORS Allowed Origins (comma-separated)
# Update with your Tailscale hostname
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://mac-mini.tailnet-name.ts.net:3000

# Session Secret (generate with: openssl rand -base64 32)
SESSION_SECRET=your_qa_session_secret_here

# JWT Secret (generate with: openssl rand -base64 32)
# Note: Clerk handles JWT signing, this is for any additional app tokens
JWT_SECRET=your_qa_jwt_secret_here

#==============================================================================
# FEATURE FLAGS
#==============================================================================

# Enable/Disable Features
FEATURE_RULES_ENGINE=true
FEATURE_AI_INSIGHTS=false
FEATURE_MULTI_REGION=false

#==============================================================================
# DEVELOPMENT TOOLS
#==============================================================================

# Enable development tools
ENABLE_SWAGGER_UI=true
ENABLE_PRISM_MOCK=false

# Hot Reload
VITE_HMR_ENABLED=true

#==============================================================================
# NOTES FOR QA
#==============================================================================
# 1. Copy this file: cp .env.qa.example .env.qa
# 2. Fill in all credentials (use test/sandbox/dev credentials ONLY)
# 3. NEVER commit .env.qa to git (it's in .gitignore)
# 4. Use separate Clerk dev instance (not production)
# 5. Use Plaid sandbox mode ALWAYS
# 6. Use Stripe test mode keys ONLY
# 7. Generate new encryption key (different from production)
# 8. Update Tailscale hostname after setting up Tailscale
#
# Security Reminders:
# - ALL credentials should be test/sandbox/dev versions
# - NEVER use production credentials in QA
# - Rotate secrets regularly
# - Use different encryption keys for QA vs production
#
# Access via Tailscale VPN:
# - Frontend: http://mac-mini.tailnet-name.ts.net:3000
# - Backend API: http://mac-mini.tailnet-name.ts.net:8080
# - RabbitMQ UI: http://mac-mini.tailnet-name.ts.net:15673
