test-results.json

# Self-signed certificates (regenerate locally)
*.pem

# Backup files (e.g., cert.pem.bak during E2E test runs)
*.bak

# E2E test environment (contains secrets)
.env.e2e

# E2E auth session state (generated during test runs)
e2e/.auth/*.json

# E2E test output log (generated by run script)
e2e-output.log
