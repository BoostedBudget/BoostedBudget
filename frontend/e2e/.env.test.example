# E2E Test Environment Configuration
# Copy to .env.test and fill in actual values for running E2E tests

# Auth0 Test Credentials
# Create a test user in your Auth0 test tenant for E2E testing
TEST_AUTH0_EMAIL=test-user@example.com
TEST_AUTH0_PASSWORD=TestPassword123!

# Auth0 Configuration (should match your test tenant)
VITE_AUTH0_DOMAIN=your-test-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your-test-client-id
VITE_AUTH0_AUDIENCE=https://api.boostedbudget.com

# Test Environment URLs
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:8080

# Optional: Use headless mode
HEADLESS=true
