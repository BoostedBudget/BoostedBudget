{
  "name": "boostedbudget-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "tsc --noEmit && vitest run --no-cache --coverage --reporter=verbose --reporter=json --outputFile=test-results.json",
    "test:ci:run": "tsc --noEmit && vitest run --no-cache --coverage --reporter=verbose --reporter=json --outputFile=test-results.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest watch --config vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "test:e2e": "bash scripts/run-e2e-with-ports.sh",
    "test:e2e:ci": "bash scripts/run-e2e-with-ports.sh",
    "test:e2e:ui": "bash scripts/run-e2e-with-ports.sh --ui",
    "test:e2e:headed": "bash scripts/run-e2e-with-ports.sh --headed",
    "test:e2e:debug": "bash scripts/run-e2e-with-ports.sh --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:all": "tsc --noEmit && npm test -- --run && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.9.0",
    "@reduxjs/toolkit": "^2.11.0",
    "@types/react-datepicker": "^6.2.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "js-cookie": "^3.0.5",
    "react": "^19.2.0",
    "react-datepicker": "^8.9.0",
    "react-dom": "^19.2.0",
    "react-plaid-link": "^4.1.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-cookie": "^3.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.13",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.2.0",
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.3"
  }
}
