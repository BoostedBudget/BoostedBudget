{
  "name": "boostedbudget-frontend",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest run",
    "test:watch": "NODE_OPTIONS='--max-old-space-size=4096' vitest",
    "test:ci": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit && NODE_OPTIONS='--max-old-space-size=4096' vitest run --no-cache --coverage --reporter=verbose --reporter=json --outputFile=test-results.json",
    "test:ci:run": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit && NODE_OPTIONS='--max-old-space-size=4096' vitest run --no-cache --coverage --reporter=verbose --reporter=json --outputFile=test-results.json",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest watch --config vitest.integration.config.ts",
    "test:ui": "vitest --ui",
    "test:e2e": "bash scripts/run-e2e-with-ports.sh",
    "test:e2e:ci": "bash scripts/run-e2e-with-ports.sh",
    "test:e2e:ui": "bash scripts/run-e2e-with-ports.sh --ui",
    "test:e2e:headed": "bash scripts/run-e2e-with-ports.sh --headed",
    "test:e2e:debug": "bash scripts/run-e2e-with-ports.sh --debug",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:all": "tsc --noEmit && npm test -- --run && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.11.0",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react-datepicker": "^7.0.0",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "gridstack": "^12.4.1",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.561.0",
    "plotly.js-basic-dist": "^3.3.1",
    "react": "^19.2.3",
    "react-datepicker": "^9.0.0",
    "react-dom": "^19.2.3",
    "react-plaid-link": "^4.1.1",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/js-cookie": "^3.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-plotly.js": "^2.6.4",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.3"
  }
}
