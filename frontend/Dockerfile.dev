# Development Dockerfile for Frontend
# Issue #575: Migrated from Node/pnpm to Bun
FROM oven/bun:latest

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json bun.lock ./

# Install dependencies
RUN echo "Installing development dependencies..." && \
    for i in 1 2 3 4; do \
      echo "bun install attempt $i/4..." && \
      bun install --frozen-lockfile && \
      echo "Dependencies installed" && break || \
      { echo "bun install attempt $i/4 failed"; \
        rm -rf ~/.bun/install/cache; \
        [ $i -lt 4 ] && sleep 10; }; \
    done

# Copy source
COPY . .

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Run Bun dev server with hot reload
CMD ["bun", "run", "dev"]
