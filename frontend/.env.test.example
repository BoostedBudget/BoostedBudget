# E2E Test Environment Configuration (Frontend)
# Copy this file to .env.test and fill in the values
# Issue #331: E2E Test Scenarios Framework

# API Configuration (Points to test backend on port 8081)
VITE_API_URL=http://localhost:8081

# Auth0 Test Tenant (Must match backend configuration)
VITE_AUTH0_DOMAIN=test-boostedbudget.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_test_auth0_client_id
VITE_AUTH0_AUDIENCE=https://api.test.boostedbudget.com
VITE_AUTH0_CALLBACK_URL=http://localhost:3000/callback

# Feature Flags (Disable ads in test environment)
VITE_GOOGLE_ADSENSE_ENABLED=false
VITE_GOOGLE_ADSENSE_CLIENT=

# Test Mode
VITE_TEST_MODE=true

# Logging
VITE_LOG_LEVEL=debug

# Playwright Test Configuration
# Test database URLs (set automatically by globalSetup)
# TEST_DATABASE_URL_0=postgres://testuser:testpass@localhost:5433/boostedbudget_test_worker_0?sslmode=disable
# TEST_DATABASE_URL_1=postgres://testuser:testpass@localhost:5433/boostedbudget_test_worker_1?sslmode=disable
# TEST_DATABASE_URL_2=postgres://testuser:testpass@localhost:5433/boostedbudget_test_worker_2?sslmode=disable
# TEST_DATABASE_URL_3=postgres://testuser:testpass@localhost:5433/boostedbudget_test_worker_3?sslmode=disable
