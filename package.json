{
  "name": "boostedbudget",
  "private": true,
  "packageManager": "bun@1.1.29",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:api": "turbo run generate:api --filter=@boostedbudget/api-client"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.0.1",
    "serve": "^14.2.6",
    "size-limit": "^12.0.1",
    "turbo": "^2.8.12"
  },
  "overrides": {
    "minimatch": ">=10.2.3",
    "rollup": ">=4.59.0",
    "markdown-it": ">=14.1.1",
    "flatted": ">=3.4.2",
    "undici": ">=7.24.0",
    "picomatch": ">=4.0.4",
    "yaml": ">=2.8.3",
    "brace-expansion": ">=5.0.5"
  }
}
