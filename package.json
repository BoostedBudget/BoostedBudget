{
  "name": "boostedbudget",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:api": "turbo run generate:api --filter=@boostedbudget/api-client",
    "generate:posthog": "bun run scripts/generate-posthog-events.ts",
    "validate:posthog": "bun test --timeout 30000 scripts/generate-posthog-events.test.ts scripts/validate-posthog-rollout.test.ts && bun run scripts/generate-posthog-events.ts --check && bun run scripts/validate-posthog-rollout.ts"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^12.1.0",
    "basic-ftp": ">=6.2.4",
    "serve": "^14.2.6",
    "size-limit": "^12.1.0",
    "turbo": "^2.10.9",
    "yaml": "2.8.3"
  },
  "overrides": {
    "js-cookie": ">=3.0.7",
    "minimatch": ">=10.2.3",
    "rollup": ">=4.59.0",
    "markdown-it": ">=14.1.1",
    "flatted": ">=3.4.2",
    "undici": ">=7.30.1 <8",
    "picomatch": ">=4.0.4",
    "postcss": ">=8.5.18",
    "yaml": "2.8.3",
    "brace-expansion": ">=5.0.12",
    "ip-address": ">=10.7.4 <11",
    "tmp": ">=0.2.7",
    "protobufjs": ">=7.6.1 <8",
    "form-data": ">=4.0.6",
    "ws": ">=8.21.0",
    "vite": ">=8.1.6",
    "dompurify": ">=3.4.17",
    "follow-redirects": ">=1.16.2",
    "protocol-buffers-schema": ">=3.6.1",
    "fast-uri": ">=3.1.9 <4",
    "esbuild": "0.28.1",
    "hono": ">=4.13.16",
    "linkify-it": ">=5.0.2 <6",
    "js-yaml": ">=4.3.2 <5",
    "nanoid": ">=3.3.17",
    "sharp": ">=0.35.5",
    "puppeteer-core": ">=25.6.0",
    "qs": ">=6.16.1",
    "uuid": ">=11.1.1 <12",
    "source-map-js": ">=1.2.2",
    "compression": ">=1.8.2",
    "decode-uri-component": ">=0.5.1",
    "happy-dom": ">=21.0.4",
    "zod": ">=4.6.6",
    "@modelcontextprotocol/sdk": ">=1.32.0",
    "@modelcontextprotocol/client": ">=2.3.0",
    "@modelcontextprotocol/server": ">=2.3.0",
    "basic-ftp": ">=6.2.4"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
