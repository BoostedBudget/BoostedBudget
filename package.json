{
  "name": "boostedbudget",
  "private": true,
  "packageManager": "bun@1.1.29",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "generate:api": "turbo run generate:api --filter=@boostedbudget/api-client"
  },
  "devDependencies": {
    "turbo": "^2.8.10"
  },
  "overrides": {
    "minimatch": "^10.2.2"
  }
}
