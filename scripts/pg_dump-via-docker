#!/usr/bin/env bash
# pg_dump-via-docker — run pg_dump from INSIDE the running Postgres container.
#
# Why this exists: pg_dump refuses to dump a server whose major version is newer than its own. This
# repo's CI starts a `postgres:17` container on a self-hosted macOS runner whose newest available
# client is 15, so the host's pg_dump can never dump it. Using the server container's own binary
# makes the version match true by construction, needs nothing installed on the host, and keeps
# working if the server image is bumped again.
#
# That mattered more than a normal tooling annoyance: because scripts/test-migrations.sh discarded
# pg_dump's stderr and hashed its (empty) stdout, a version mismatch made the idempotency and
# up->down->up schema-identity suites compare an empty string with itself and report PASSED. Those
# two assertions were silently verifying nothing, locally and in CI, until an empty-dump guard
# caught it. A round-3 audit found several more ways this shim itself could still produce that same
# empty/wrong dump silently (see below) — they are now guarded against and covered by
# scripts/__tests__/pg_dump-via-docker.test.sh.
#
# Usage:
#   PG_DUMP="$PWD/scripts/pg_dump-via-docker" ./scripts/test-migrations.sh
#
# Container selection:
#   PG_DUMP_CONTAINER=<name>   explicit, preferred in CI where the name is known. Validated: must
#                              name a container that is actually running, or this exits with an
#                              error instead of letting `docker exec` fail into an empty dump.
#   otherwise                  auto-detect a single running container whose image is (exactly, not
#                              a substring) postgres. `docker ps` only lists running containers, so
#                              an auto-detected candidate needs no separate running check.
#
# The DATABASE_URL passed through by the caller keeps working unchanged: it points at
# localhost:5432, which inside the server's own container is that same server.
#
# This file is both the CI-invoked executable (`PG_DUMP="$PWD/scripts/pg_dump-via-docker"`) and,
# via the BASH_SOURCE guard at the bottom, sourceable by
# scripts/__tests__/pg_dump-via-docker.test.sh, which sources it to exercise rewrite_pg_url,
# valid_port and is_postgres_image directly, without Docker. Sourcing only defines functions; it
# does not run main (and, notably, does not itself turn on `set -euo pipefail` for the sourcing
# shell — that is enabled inside main, once, only for the direct-execution path).

# rewrite_pg_url URL PORT
# Rewrite a postgres://... or postgresql://... URL's host:port authority to 127.0.0.1:PORT.
#
# Only the authority (host:port) is replaced. Credentials are preserved verbatim: everything up to
# and including the LAST '@' before the first '/' is treated as "scheme + credentials" and kept;
# only the host:port between that last '@' and the first '/' is swapped for
# 127.0.0.1:<internal port>. Database name and query parameters (notably ?sslmode=disable) are
# preserved, since the substitution never reaches past the first '/'.
#
# The "last '@'" part matters: a password containing a literal '@' (e.g.
# postgres://user:p@ss@host/db) has TWO '@' characters before the '/', and the first one is part of
# the password, not the userinfo/host separator. An earlier version of this regex matched only up
# to the FIRST '@' ([^@]*@), which silently discarded everything from that first '@' through the
# next '/' — including the rest of the password AND the real host — as if it were the old
# host:port, and replaced all of it with the new host:port. For postgres://user:p@ss@host/db that
# yielded postgres://user:p@127.0.0.1:<port>/db: password truncated to "p", auth fails, empty dump
# — exactly the failure mode this shim exists to prevent. That version also required at least one
# '@' to match at all, so a bare postgres://host/db with no credentials (valid with trust/peer auth
# or PGPASSWORD) passed through completely unrewritten. Both are exercised in
# scripts/__tests__/pg_dump-via-docker.test.sh.
#
# Caveat verified while fixing this: a literal, non-percent-encoded '@' inside a password is not
# actually valid input to begin with — libpq's own URI parser (confirmed directly against psql,
# independent of this shim) splits userinfo from host at the FIRST '@', the same as the old buggy
# regex above, so postgres://user:p@ss@host/db can never authenticate correctly no matter what this
# shim does to the host:port part; the caller must percent-encode the password (p%40ss) per RFC
# 3986, which libpq decodes correctly and which this rewrite has always handled fine (only one
# literal '@' exists in that form). What THIS fix guarantees is narrower but still real: the shim
# itself no longer corrupts whatever credentials it was handed — it preserves them exactly,
# whether well-formed or not — rather than silently discarding part of them on top of whatever
# problem the caller's URL already had.
rewrite_pg_url() {
    local url="$1" port="$2"
    printf '%s' "$url" \
        | sed -E "s#^(postgres(ql)?://)([^/]*@)?[^/]*#\\1\\3127.0.0.1:${port}#"
}

# valid_port PORT — true if PORT is a bare, non-negative integer: digits only, no sign, not empty.
# PG_DUMP_CONTAINER_PORT is interpolated directly into the sed replacement string above; without
# this check, a value containing sed-replacement metacharacters ('#', '&', '\') could corrupt the
# rewrite or be a script-injection seam. Restricting to [0-9]+ makes that impossible.
valid_port() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

# is_postgres_image IMAGE — true if IMAGE's repository component is exactly "postgres".
#
# The repository is the path segment after the last '/', with any ':tag' or '@digest' suffix
# stripped — so "postgres:17-alpine", "postgres", and "docker.io/library/postgres:17" all match,
# but "postgres_exporter:latest", "myrepo/postgres-sidecar:1" and
# "quay.io/prometheuscommunity/postgres-exporter:v0.15" do not. A previous version matched with
# `$2 ~ /postgres/` (substring, not anchored), so any Postgres-adjacent sidecar or custom-named
# image containing the word "postgres" could be auto-selected — and then `pg_dump` is not on its
# PATH (or is a different major version), producing an empty dump instead of a clear error.
is_postgres_image() {
    local image="$1" repo
    repo="${image##*/}"   # strip registry/namespace path, if any
    repo="${repo%%:*}"    # strip :tag
    repo="${repo%%@*}"    # strip @digest
    [ "$repo" = "postgres" ]
}

# container_is_running NAME — true if NAME names a container that currently exists and is running.
# Used to validate an explicit PG_DUMP_CONTAINER: without this check, a stopped or non-existent
# container name reaches `docker exec` directly, which fails there instead of with a clear message
# here — and depending on the caller's error handling, can still end up producing an empty dump.
container_is_running() {
    local name="$1" running
    running="$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null)" || return 1
    [ "$running" = "true" ]
}

# detect_postgres_containers — print the name of each currently-running container (one per line)
# whose image satisfies is_postgres_image.
#
# Matches on the image rather than the name: CI names its container test-postgres-<run_id> while
# docker-compose uses a project-derived name, and neither is predictable from here.
#
# Deliberately avoids `mapfile`/`readarray` and associative/indexed-array tricks beyond plain
# `+=` — macOS ships bash 3.2, where mapfile/readarray do not exist, and both this repo's
# developers and its CI runner are macOS. (Learned the hard way: the first version of this script
# used mapfile and died with "command not found".)
detect_postgres_containers() {
    local name image
    docker ps --format '{{.Names}} {{.Image}}' 2>/dev/null | while IFS=' ' read -r name image; do
        if is_postgres_image "$image"; then
            printf '%s\n' "$name"
        fi
    done
}

main() {
    set -euo pipefail

    local container
    container="${PG_DUMP_CONTAINER:-}"

    if [ -n "$container" ]; then
        if ! container_is_running "$container"; then
            echo "pg_dump-via-docker: PG_DUMP_CONTAINER='$container' is not a running container." >&2
            echo "  Check the name (docker ps -a lists stopped containers too), fix PG_DUMP_CONTAINER," >&2
            echo "  or unset it to auto-detect instead." >&2
            exit 1
        fi
    else
        local candidates count
        candidates="$(detect_postgres_containers || true)"
        count=$(printf '%s\n' "$candidates" | grep -c . || true)

        if [ "$count" -eq 0 ]; then
            echo "pg_dump-via-docker: no running Postgres container found." >&2
            echo "  Start one (make dev, or the CI job's container step), or set PG_DUMP_CONTAINER=<name>." >&2
            echo "  Note: if your local Postgres is a native install (Homebrew, Postgres.app) rather than" >&2
            echo "  a container, this shim does not apply — install a pg_dump >= your server's major" >&2
            echo "  version instead." >&2
            exit 1
        fi
        if [ "$count" -gt 1 ]; then
            echo "pg_dump-via-docker: multiple Postgres containers running:" >&2
            printf '%s\n' "$candidates" | while IFS= read -r name; do
                printf '    %s\n' "$name" >&2
            done
            echo "  Set PG_DUMP_CONTAINER=<name> to disambiguate — guessing could dump the wrong database." >&2
            exit 1
        fi
        container=$(printf '%s\n' "$candidates" | grep . | head -1)
    fi

    # Rewrite the connection URL's host:port to the server's address as seen from INSIDE the
    # container.
    #
    # Necessary because the caller's DATABASE_URL is host-oriented. CI publishes the container with
    # `-p 5432` (no host port), so Docker assigns a random ephemeral host port and the URL becomes
    # postgres://test:test@localhost:<random>/test. Inside the container that port is not listening
    # — Postgres is on 5432 — so passing the URL through unchanged fails to connect, and (before
    # the empty-dump guard) would have produced exactly the silent empty dump this shim exists to
    # prevent. Override with PG_DUMP_CONTAINER_PORT if a container ever runs Postgres somewhere
    # other than 5432.
    local internal_port
    internal_port="${PG_DUMP_CONTAINER_PORT:-5432}"
    if ! valid_port "$internal_port"; then
        echo "pg_dump-via-docker: PG_DUMP_CONTAINER_PORT must be a plain integer port number (got '$internal_port')." >&2
        exit 1
    fi

    local args=() arg
    for arg in "$@"; do
        case "$arg" in
            postgres://*|postgresql://*)
                arg="$(rewrite_pg_url "$arg" "$internal_port")"
                ;;
        esac
        args+=("$arg")
    done

    # -i (not -it): stdout must stay a clean pipe for the caller to hash. A TTY would inject control
    # characters and silently change the hash, which is the class of bug this whole shim exists to
    # stop.
    #
    # The count check below (rather than unconditionally expanding "${args[@]}") exists because
    # bash 3.2 — macOS's shipped bash — treats "${args[@]}" on a zero-element array as an unbound
    # variable under `set -u` and aborts with "args[@]: unbound variable" instead of running
    # pg_dump with no arguments (which would otherwise just print pg_dump's own usage). Verified on
    # 3.2.57; fixed in bash 4.4+, but this repo's devs and CI runner are macOS.
    if [ "${#args[@]}" -gt 0 ]; then
        exec docker exec -i "$container" pg_dump "${args[@]}"
    else
        exec docker exec -i "$container" pg_dump
    fi
}

# Only run main when executed directly (`./pg_dump-via-docker ...` or `bash pg_dump-via-docker`),
# not when sourced by the test file — this is what lets the test file source this same file to call
# rewrite_pg_url/valid_port/is_postgres_image/container_is_running/detect_postgres_containers in
# isolation, without also running main (and without `set -euo pipefail` leaking into the test
# script's own shell).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
