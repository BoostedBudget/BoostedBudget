#!/bin/bash
# Pre-push hook to run all tests before pushing
# This prevents pushing code that fails tests locally
#
# To bypass this hook in emergencies, use: git push --no-verify

set -e

echo "🧪 Pre-push hook: Running all tests..."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# Run all tests via the Makefile
if make test-all; then
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "✅ All tests passed! Proceeding with push..."
    echo ""
    exit 0
else
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "❌ Tests failed! Push blocked."
    echo ""
    echo "Please fix the failing tests before pushing."
    echo ""
    echo "To bypass this check (not recommended), use:"
    echo "  git push --no-verify"
    echo ""
    exit 1
fi
