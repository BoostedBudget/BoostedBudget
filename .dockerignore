**/dist/
**/build/
**/coverage/

# Git
.git
.gitignore
**/.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment files (should use runtime injection)
.env
.env.local
.env.*.local
