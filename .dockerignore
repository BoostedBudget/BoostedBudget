**/.env.local
**/.env.*.local

# Testing artifacts
**/coverage/
**/.nyc_output/

# Documentation (not needed in container)
**/*.md
!config/**/*.md

# E2E tests (not needed in production image)
frontend/e2e/
frontend/playwright-report/
frontend/test-results/

# Backend specific (when building frontend only)
backend/tmp/
backend/coverage/

